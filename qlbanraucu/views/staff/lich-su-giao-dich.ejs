<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Đơn Hàng - Nam Fruit</title>
    <link rel="stylesheet" href="/Font/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="/css/staff.css">
    <script src="/js/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="sidebar">
        <a href="/trang-chu" title="Về trang chủ">
            <img src="/img/o_bg-remover-gen_2rbFSjxWiA0b8V11LXqgNGl4BsO.png" class="logo-admin" alt="Logo">
        </a>
        <h2>NHÂN VIÊN BÁN HÀNG</h2>
        <a href="/trang-chu" class="menu-item">
            <i class="fa-solid fa-house"></i> Về trang chủ
        </a>
        <a href="/staff/orders" class="menu-item">
            <i class="fa-solid fa-box"></i> Quản lý đơn hàng
        </a>
        <a href="/staff/history" class="menu-item">
            <i class="fa-solid fa-clock-rotate-left"></i> Lịch sử giao dịch
        </a>
        
        <hr style="border-color: rgba(255,255,255,0.2);">
        
        <a href="/dang-xuat" class="menu-item">
            <i class="fas fa-sign-out-alt"></i> Đăng xuất
        </a>
    </div>

    <div class="content">
        <h1 style="color: #82b53f; margin-top: 0;">📦 DANH SÁCH ĐƠN HÀNG</h1>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Ghi chú</th>
                        <th style="text-align: center;">Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(orders && orders.length > 0) { %>
                        <% orders.forEach(od => { %>
                        <tr>
                            <td>#<%= od.ma_hoa_don %></td>
                            <td style="font-weight: bold;"><%= od.ho_ten %></td>
                            <td><%= new Date(od.ngay_dat_hang).toLocaleString('vi-VN') %></td>
                            <td style="color: #c0392b; font-weight: bold;">
                                <%= new Intl.NumberFormat('vi-VN', { style: 'currency', currency: 'VND' }).format(od.tong_tien) %>
                            </td>
                            <td style="font-style: italic; color: #666; font-size: 13px;">
                                <%= od.ghi_chu || 'Không có' %>
                            </td>
                            
                            <td style="text-align: center;">
                                <% if(od.trang_thai == 'cho_xac_nhan') { %>
                                    <span class="status cho_xac_nhan">
                                        <i class="fas fa-spinner fa-spin"></i> Chờ xác nhận
                                    </span>
                                <% } else if(od.trang_thai == 'da_xac_nhan') { %>
                                    <span class="status da_xac_nhan">
                                        <i class="fas fa-truck"></i> Đã xác nhận
                                    </span>
                                <% } else if(od.trang_thai == 'da_thanh_toan') { %>
                                    <span class="status da_thanh_toan">
                                        <i class="fas fa-check-circle"></i> Đã thanh toán
                                    </span>
                                <% } else if(od.trang_thai == 'da_huy') { %>
                                    <span class="status huy">
                                        <i class="fas fa-times-circle"></i> Đã hủy
                                    </span>
                                <% } %>
                            </td>

                            <td>
                                <button class="btn-action btn-view" onclick="xemChiTiet('<%= od.ma_hoa_don %>')" title="Xem chi tiết">
                                    <i class="fas fa-eye"></i>
                                </button>
                                
                                <% if(od.trang_thai == 'cho_xac_nhan') { %>
                                    <button class="btn-action btn-confirm" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'xac_nhan')" title="Xác nhận đơn">
                                        <i class="fas fa-check"></i>
                                    </button>
                                    <button class="btn-action btn-cancel" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'huy')" title="Hủy đơn">
                                        <i class="fas fa-times"></i>
                                    </button>
                                <% } %>

                                <% if(od.trang_thai == 'da_xac_nhan') { %>
                                    <button class="btn-action btn-pay" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'thanh_toan')" title="Xác nhận đã thu tiền">
                                        <i class="fas fa-money-bill-wave"></i> Thu tiền
                                    </button>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 20px; color: #7f8c8d;">
                                <i class="fas fa-inbox" style="font-size: 30px; margin-bottom: 10px;"></i><br>
                                Chưa có đơn hàng nào cần xử lý.
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="detailModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="$('#detailModal').hide()">&times;</span>
            <h2 style="color: #82b53f;">Chi tiết đơn hàng #<span id="modalOrderId"></span></h2>
            <table style="margin-top: 15px;">
                <thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Giá lúc mua</th><th>SL</th><th>Thành tiền</th></tr></thead>
                <tbody id="modalBody"></tbody>
            </table>
        </div>
    </div>

    <script src="/js/staff.js"></script>
</body>
</html>