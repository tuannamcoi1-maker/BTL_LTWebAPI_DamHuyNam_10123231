<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản Lý Đơn Hàng - Nam Fruit</title>
    <link rel="stylesheet" href="/Font/fontawesome-free-6.7.2-web/css/all.min.css">
    <link rel="stylesheet" href="/css/staff.css">
    <script src="/js/jquery-3.6.0.min.js"></script>
</head>
<body>
    <div class="sidebar">
        <a href="/trang-chu" title="Về trang chủ">
            <img src="/img/o_bg-remover-gen_2rbFSjxWiA0b8V11LXqgNGl4BsO.png" class="logo-admin" alt="Logo">
        </a>
        <h2>NHÂN VIÊN BÁN HÀNG</h2>
        
        <a href="#" class="menu-item active">
            <i class="fas fa-clipboard-list"></i> Quản lý Đơn hàng
        </a>
        
        <hr style="border-color: rgba(255,255,255,0.2);">
        
        <a href="/dang-xuat" class="menu-item">
            <i class="fas fa-sign-out-alt"></i> Đăng xuất
        </a>
    </div>

    <div class="content">
        <h1 style="color: #82b53f; margin-top: 0;">📦 DANH SÁCH ĐƠN HÀNG</h1>
        
        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Khách hàng</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Ghi chú</th>
                        <th>Trạng thái</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    <% if(orders && orders.length > 0) { %>
                        <% orders.forEach(od => { %>
                        <tr>
                            <td>#<%= od.ma_hoa_don %></td>
                            <td style="font-weight: bold;"><%= od.ho_ten %></td>
                            <td><%= new Date(od.ngay_dat_hang).toLocaleString() %></td>
                            <td style="color: red; font-weight: bold;"><%= od.tong_tien.toLocaleString() %>₫</td>
                            <td style="font-style: italic; color: #666;"><%= od.ghi_chu || 'Không có' %></td>
                            <td>
                                <span class="status <%= od.trang_thai.toLowerCase() %>">
                                    <% 
                                        let tt = od.trang_thai;
                                        // [ĐÃ SỬA] So sánh với chữ thường để khớp Database
                                        if(tt == 'cho_xac_nhan') tt = 'Chờ xác nhận';
                                        if(tt == 'da_xac_nhan') tt = 'Đã xác nhận';
                                        if(tt == 'da_thanh_toan') tt = 'Đã thanh toán';
                                        if(tt == 'huy') tt = 'Đã hủy';
                                    %>
                                    <%= tt %>
                                </span>
                            </td>
                            <td>
                                <button class="btn-action btn-view" onclick="xemChiTiet('<%= od.ma_hoa_don %>')" title="Xem chi tiết"><i class="fas fa-eye"></i></button>
                                
                                <% if(od.trang_thai == 'cho_xac_nhan') { %>
                                    <button class="btn-action btn-confirm" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'xac_nhan')" title="Xác nhận đơn"><i class="fas fa-check"></i></button>
                                    <button class="btn-action btn-cancel" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'huy')" title="Hủy đơn"><i class="fas fa-times"></i></button>
                                <% } %>

                                <% if(od.trang_thai == 'da_xac_nhan') { %>
                                    <button class="btn-action btn-pay" onclick="capNhatTrangThai('<%= od.ma_hoa_don %>', 'thanh_toan')" title="Xác nhận đã thu tiền"><i class="fas fa-money-bill-wave"></i> Thu tiền</button>
                                <% } %>
                            </td>
                        </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="7" style="text-align: center;">Chưa có đơn hàng nào.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <div id="detailModal" class="modal">
        <div class="modal-content">
            <span class="close" onclick="$('#detailModal').hide()">&times;</span>
            <h2 style="color: #82b53f;">Chi tiết đơn hàng #<span id="modalOrderId"></span></h2>
            <table style="margin-top: 15px;">
                <thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Giá lúc mua</th><th>SL</th><th>Thành tiền</th></tr></thead>
                <tbody id="modalBody"></tbody>
            </table>
        </div>
    </div>

    <script src="/js/staff.js"></script>
</body>
</html> 